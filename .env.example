# Valeur pour le PostgreSQL de développement lancé par docker compose.
DATABASE_URL=postgres://rugby:rugby@localhost:5432/rugby
# Facultatif en local : définis ces deux valeurs ensemble pour créer un administrateur.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Le serveur génère et conserve le secret dans PostgreSQL si cette variable est absente.
# SESSION_SECRET=
COOKIE_SECURE=false
TRUST_PROXY=0
